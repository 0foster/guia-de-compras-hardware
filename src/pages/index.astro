---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FilterPanel from '../components/filter/FilterPanel.astro';
import GpuCard from '../components/gpu/GpuCard.astro';
import WebsiteSchema from '../components/seo/WebsiteSchema.astro';
import { getAllGpus, getAffiliateLinks } from '../utils/gpu';

const gpus = getAllGpus();
---

<BaseLayout title="Guia de Compras Hardware | Encontre a GPU ideal">
  <WebsiteSchema slot="head" />
  <div class="flex min-h-screen flex-col">
    <Header />

    <div class="mx-auto flex w-full max-w-screen-2xl flex-1">
      <!-- Desktop Sidebar -->
      <aside
        id="sidebar"
        class="hidden w-72 shrink-0 overflow-y-auto border-r border-gray-200 bg-white p-5 transition-all duration-300 lg:block dark:border-gray-800 dark:bg-gray-950"
      >
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-900 dark:text-gray-100">Filtros</h2>
          <button
            id="sidebar-toggle"
            class="flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
            aria-label="Retrair filtros"
          >
            <span class="toggle-label">Retrair</span>
            <span class="toggle-icon">&lt;</span>
          </button>
        </div>
        <FilterPanel namePrefix="desktop" />
      </aside>

      <!-- Mobile Drawer Overlay -->
      <div id="mobile-overlay" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"></div>

      <!-- Mobile Drawer -->
      <div
        id="mobile-drawer"
        class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto bg-white p-5 shadow-xl transition-transform duration-300 lg:hidden dark:bg-gray-950"
      >
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-900 dark:text-gray-100">Filtros</h2>
          <button
            id="mobile-drawer-close"
            class="rounded-lg p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
            aria-label="Fechar filtros"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <FilterPanel namePrefix="mobile" />
      </div>

      <!-- Main Content (Results) -->
      <main class="flex-1 p-4 lg:p-6">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Placas de Vídeo</h1>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Encontre a GPU perfeita para o seu uso. Use os filtros para refinar sua busca.
          </p>
        </div>

        <!-- GPU Grid -->
        <div id="gpu-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {gpus.map((gpu) => {
            const links = getAffiliateLinks(gpu.slug);
            return (
              <GpuCard
                slug={gpu.slug}
                shortName={gpu.shortName}
                vram={gpu.vram}
                targetResolution={gpu.targetResolution}
                aiSummary={gpu.aiSummary}
                fpsAvgIdeal={gpu.fps[gpu.targetResolution[0] as keyof typeof gpu.fps].avg}
                priceMin={links?.priceRange.min}
                inStock={gpu.inStock}
              />
            );
          })}
        </div>

        <!-- No results message -->
        <div id="no-results" class="hidden py-16 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="mt-4 text-gray-500 dark:text-gray-400">Nenhuma placa encontrada com esses filtros.</p>
          <p class="text-sm text-gray-400 dark:text-gray-500">Tente ajustar os filtros ou limpar a seleção.</p>
        </div>
      </main>
    </div>

    <Footer />
  </div>

  <script src="../components/filter/filter.ts"></script>
</BaseLayout>

<style>
  .sidebar-collapsed {
    width: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    border: none !important;
  }
</style>
