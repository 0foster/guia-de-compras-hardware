---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import GpuSpecTable from '../../components/gpu/GpuSpecTable.astro';
import FpsBenchmark from '../../components/gpu/FpsBenchmark.astro';
import GameFpsTable from '../../components/gpu/GameFpsTable.astro';
import BuyButton from '../../components/gpu/BuyButton.astro';
import AdjacentGpus from '../../components/gpu/AdjacentGpus.astro';
import ProductSchema from '../../components/seo/ProductSchema.astro';
import CompareTray from '../../components/compare/CompareTray.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { getAllGpus, getAffiliateLinks, getGpuBySlug } from '../../utils/gpu';
import { compareUrl } from '../../utils/compare';
import gpuData from '../../data/gpus.json';
import { formatFps } from '../../utils/format';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (() => {
  const gpus = getAllGpus();
  return gpus.map((gpu) => ({
    params: { slug: gpu.slug },
    props: { gpu },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { gpu } = Astro.props as Props;
const links = getAffiliateLinks(gpu.slug);
const compareWith = [gpu.adjacentGpus.stepDown, gpu.adjacentGpus.stepUp]
  .map((slug) => (slug ? getGpuBySlug(slug) : undefined))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
---

<BaseLayout
  title={`${gpu.shortName} — Specs, Benchmarks e Onde Comprar | Guia de Compras Hardware`}
  description={gpu.metaDescription}
  ogType="product"
>
  <ProductSchema slot="head" {gpu} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Home', url: '/' },
      { name: gpu.shortName, url: Astro.url.pathname },
    ]}
  />

  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-8 lg:px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-gray-500 dark:text-gray-400">
        <a href="/" class="hover:text-gray-700 dark:hover:text-gray-200">Home</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 dark:text-gray-100">{gpu.shortName}</span>
      </nav>

      <!-- Hero -->
      <div class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-start">
        <!-- Imagem do produto (ilustrativa) -->
        <figure class="w-full shrink-0 lg:w-80">
          <div class="flex h-64 items-center justify-center rounded-xl bg-gray-100 lg:h-72 dark:bg-gray-800" role="img" aria-label={`Ilustração de placa de vídeo ${gpu.shortName}`}>
            <svg class="h-24 w-24 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <figcaption class="mt-2 text-center text-xs italic text-gray-500 dark:text-gray-400">
            *Imagem meramente ilustrativa, modelos disponíveis podem variar dia para dia.
          </figcaption>
        </figure>

        <div class="flex-1">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{gpu.name}</h1>
          <div class="mt-2 flex flex-wrap gap-2">
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
              {gpu.vram} GB {gpu.vramType}
            </span>
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
              Ideal: {gpu.targetResolution[0]}
            </span>
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
              {formatFps(gpu.fps[gpu.targetResolution[0] as keyof typeof gpu.fps].avg)} FPS médio em {gpu.targetResolution[0]}
            </span>
          </div>

          <!-- Buy buttons -->
          <div class="mt-6">
            <BuyButton amazon={links?.amazon} mercadoLivre={links?.mercadoLivre} />
            <button
              type="button"
              data-compare-toggle={gpu.slug}
              data-label-add="+ Adicionar à comparação"
              data-label-added="✓ Na comparação"
              aria-pressed="false"
              class="mt-3 w-full rounded-xl border-2 border-dashed border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-600 transition-colors hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)] aria-pressed:border-solid aria-pressed:border-[var(--color-brand-red)] aria-pressed:text-[var(--color-brand-red)] dark:border-gray-700 dark:text-gray-300"
            >
              + Adicionar à comparação
            </button>
          </div>
        </div>
      </div>

      <!-- AI Summary -->
      <section class="mb-8">
        <h2 class="mb-3 text-xl font-bold text-gray-900 dark:text-gray-100">Vale a Pena?</h2>
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 dark:border-gray-800 dark:bg-gray-900">
          <p class="leading-relaxed text-gray-700 dark:text-gray-300">{gpu.aiSummary}</p>
        </div>
      </section>

      <!-- Benchmarks -->
      <section class="mb-8">
        <h2 class="mb-3 text-xl font-bold text-gray-900 dark:text-gray-100">FPS Médio por Resolução</h2>
        <FpsBenchmark fps={gpu.fps} note={gpu.benchmarkNote} />
      </section>

      <!-- FPS por jogo -->
      <section class="mb-8">
        <h2 class="mb-3 text-xl font-bold text-gray-900 dark:text-gray-100">FPS por Jogo</h2>
        <GameFpsTable gpuSlug={gpu.slug} defaultResolution={gpu.targetResolution[0] as '1080p' | '1440p' | '4K'} />
      </section>

      <!-- Specs -->
      <section class="mb-8">
        <h2 class="mb-3 text-xl font-bold text-gray-900 dark:text-gray-100">Especificações Técnicas</h2>
        <GpuSpecTable
          vram={gpu.vram}
          vramType={gpu.vramType}
          tdp={gpu.tdp}
          cudaCores={gpu.cudaCores}
          baseClock={gpu.baseClock}
          boostClock={gpu.boostClock}
          memoryBus={gpu.memoryBus}
          memoryBandwidth={gpu.memoryBandwidth}
          pciExpress={gpu.pciExpress}
          recommendedPsu={gpu.recommendedPsu}
          displayOutputs={gpu.displayOutputs}
        />
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          Especificações oficiais de referência da NVIDIA. Modelos de outras marcas podem ter clocks, consumo e saídas diferentes.
          Fonte:{' '}
          <a href={gpuData.sources.specs.url} target="_blank" rel="noopener" class="underline hover:text-gray-700 dark:hover:text-gray-200">NVIDIA</a>.
        </p>
      </section>

      <!-- Adjacent GPUs -->
      <section class="mb-8">
        <h2 class="mb-3 text-xl font-bold text-gray-900 dark:text-gray-100">Compare</h2>
        <AdjacentGpus stepDown={gpu.adjacentGpus.stepDown} stepUp={gpu.adjacentGpus.stepUp} />
        {compareWith.length > 0 && (
          <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-gray-500 dark:text-gray-400">Comparar lado a lado:</span>
            {compareWith.map((other) => (
              <a
                href={compareUrl([gpu.slug, other.slug])}
                class="rounded-full border border-gray-300 px-3 py-1 font-medium text-gray-700 transition-colors hover:border-[var(--color-brand-red)] hover:text-[var(--color-brand-red)] dark:border-gray-700 dark:text-gray-300"
                data-compare-link={other.slug}
              >
                {gpu.shortName} vs {other.shortName}
              </a>
            ))}
          </div>
        )}
      </section>
    </main>

    <Footer />
  </div>

  <CompareTray />
</BaseLayout>
