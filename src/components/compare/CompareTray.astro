---
import { getAllGpus } from '../../utils/gpu';
import { MAX_COMPARE } from '../../utils/compare';

// Nomes curtos das placas, para a barra montar as etiquetas no navegador.
const names = Object.fromEntries(getAllGpus().map((g) => [g.slug, g.shortName]));
---

<div
  data-compare-tray
  data-names={JSON.stringify(names)}
  class="fixed inset-x-0 bottom-0 z-40 hidden border-t-2 border-[var(--color-brand-red)] bg-white px-4 py-3 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] dark:bg-gray-950"
  role="region"
  aria-label="Placas escolhidas para comparar"
>
  <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center gap-2">
    <span data-tray-title class="text-sm font-semibold text-gray-900 dark:text-gray-100">Comparar (0 de {MAX_COMPARE})</span>
    <div data-tray-chips class="flex flex-wrap gap-2"></div>
    <span data-tray-hint class="text-xs text-gray-500 dark:text-gray-400" aria-live="polite"></span>
    <div class="ml-auto flex items-center gap-3">
      <button type="button" data-tray-clear class="text-sm text-gray-500 underline hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200">Limpar</button>
      <a
        data-tray-go
        href="/comparar"
        class="rounded-lg bg-[var(--color-brand-red)] px-4 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90 aria-disabled:pointer-events-none aria-disabled:opacity-40"
      >
        Comparar agora →
      </a>
    </div>
  </div>
</div>

<script src="./compare-tray.ts"></script>
