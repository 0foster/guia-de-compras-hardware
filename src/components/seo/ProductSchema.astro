---
import JsonLd from './JsonLd.astro';
import type { Gpu } from '../../utils/gpu';

interface Props {
  gpu: Gpu;
  image?: string;
}

const { gpu, image } = Astro.props;
const imageURL = image ? new URL(image, Astro.site).toString() : undefined;

// Sem "offers": só publicamos preço em dados estruturados quando ele vier
// garantido da própria loja (ex.: via API). Preço estimado aqui violaria as
// diretrizes do Google e das lojas parceiras.
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: gpu.name,
  description: gpu.metaDescription,
  brand: { '@type': 'Brand', name: 'NVIDIA' },
  category: 'Placa de Vídeo',
};

if (imageURL) schema.image = imageURL;
---

<JsonLd schema={schema} />
