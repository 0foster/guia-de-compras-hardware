---

interface StoreLink {
  url: string;
  displayPrice: number;
  sellerNote?: string;
  inStock: boolean;
}

interface Props {
  amazon?: StoreLink;
  mercadoLivre?: StoreLink;
}

const { amazon, mercadoLivre } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row">
  {amazon && (
    <a
      href={amazon.url}
      target="_blank"
      rel="noopener nofollow sponsored"
      class:list={[
        'flex flex-1 items-center justify-between rounded-xl border-2 px-5 py-4 transition-all',
        amazon.inStock
          ? 'border-[#FF9900] bg-[#FF9900]/5 hover:bg-[#FF9900]/10 dark:border-[#FF9900]/60 dark:bg-[#FF9900]/5 dark:hover:bg-[#FF9900]/10'
          : 'pointer-events-none border-gray-200 opacity-50 dark:border-gray-700',
      ]}
    >
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Amazon</span>
        {amazon.sellerNote && (
          <p class="text-xs text-gray-400 dark:text-gray-500">{amazon.sellerNote}</p>
        )}
      </div>
      <div class="text-right">
        {amazon.inStock ? (
          <span class="flex items-center gap-1 text-sm font-bold text-[#FF9900]">
            Ver preço
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        ) : (
          <span class="text-sm text-gray-400">Indisponível</span>
        )}
      </div>
    </a>
  )}

  {mercadoLivre && (
    <a
      href={mercadoLivre.url}
      target="_blank"
      rel="noopener nofollow sponsored"
      class:list={[
        'flex flex-1 items-center justify-between rounded-xl border-2 px-5 py-4 transition-all',
        mercadoLivre.inStock
          ? 'border-[#FFE600] bg-[#FFE600]/5 hover:bg-[#FFE600]/10 dark:border-[#FFE600]/40 dark:bg-[#FFE600]/5 dark:hover:bg-[#FFE600]/10'
          : 'pointer-events-none border-gray-200 opacity-50 dark:border-gray-700',
      ]}
    >
      <div>
        <span class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Mercado Livre</span>
        {mercadoLivre.sellerNote && (
          <p class="text-xs text-gray-400 dark:text-gray-500">{mercadoLivre.sellerNote}</p>
        )}
      </div>
      <div class="text-right">
        {mercadoLivre.inStock ? (
          <span class="flex items-center gap-1 text-sm font-bold text-[#3483FA]">
            Ver preço
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        ) : (
          <span class="text-sm text-gray-400">Indisponível</span>
        )}
      </div>
    </a>
  )}
</div>
