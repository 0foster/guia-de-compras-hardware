---
import { formatFps } from '../../utils/format';

interface Props {
  slug: string;
  shortName: string;
  vram: number;
  targetResolution: string[];
  aiSummary: string;
  fpsAvgIdeal: number;
  inStock?: boolean;
}

const {
  slug,
  shortName,
  vram,
  targetResolution,
  aiSummary,
  fpsAvgIdeal,
  inStock = true,
} = Astro.props;
---

<article
  class="gpu-card group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-gray-900"
  data-slug={slug}
  data-vram={vram}
  data-resolution={targetResolution.join(',')}
>
  <!-- Imagem placeholder -->
  <div class="relative flex h-48 items-center justify-center bg-gray-100 dark:bg-gray-800">
    <button
      type="button"
      data-compare-toggle={slug}
      aria-pressed="false"
      aria-label={`Comparar ${shortName}`}
      class="absolute top-3 right-3 rounded-lg border border-[var(--color-brand-red)] bg-white px-2.5 py-1 text-xs font-semibold text-[var(--color-brand-red)] transition-colors hover:bg-red-50 aria-pressed:bg-[var(--color-brand-red)] aria-pressed:text-white dark:bg-gray-900"
    >
      + Comparar
    </button>
    <svg class="h-20 w-20 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
    </svg>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <!-- Nome + Tags -->
    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">{shortName}</h3>
    <div class="mt-1.5 flex flex-wrap gap-1.5">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        {vram} GB
      </span>
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        {targetResolution[0]}
      </span>
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        {formatFps(fpsAvgIdeal)} FPS
      </span>
    </div>

    <!-- FPS no critério escolhido nos filtros (preenchido pelo filter.ts) -->
    <p data-card-metric class="mt-3 hidden text-sm text-gray-700 dark:text-gray-300" aria-live="polite"></p>

    <!-- Resumo -->
    <p class="mt-3 line-clamp-2 text-sm text-gray-500 dark:text-gray-400">
      {aiSummary}
    </p>

    <!-- Preço + CTA -->
    <div class="mt-auto pt-4">
      {inStock ? (
        <p class="text-sm font-medium text-[var(--color-brand-red)]">Consultar preço →</p>
      ) : (
        <p class="text-sm text-gray-500 dark:text-gray-400">Indisponível</p>
      )}
      <a
        href={`/gpus/${slug}`}
        class="mt-2 flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition-colors"
        style={`background-color: var(--color-brand-red); hover:background-color: var(--color-brand-red-hover);`}
        class:list={[
          'hover:opacity-90',
          !inStock && 'opacity-50 pointer-events-none',
        ]}
      >
        {inStock ? 'Ver detalhes' : 'Indisponível'}
      </a>
    </div>
  </div>
</article>
