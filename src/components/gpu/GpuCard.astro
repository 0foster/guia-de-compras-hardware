---
import { formatBRL } from '../../utils/format';

interface Props {
  slug: string;
  shortName: string;
  vram: number;
  targetResolution: string[];
  aiSummary: string;
  fpsAvg1440p: number;
  priceMin?: number;
  priceMax?: number;
  inStock?: boolean;
}

const {
  slug,
  shortName,
  vram,
  targetResolution,
  aiSummary,
  fpsAvg1440p,
  priceMin,
  priceMax,
  inStock = true,
} = Astro.props;
---

<article
  class="gpu-card group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-gray-900"
  data-slug={slug}
  data-vram={vram}
  data-price-min={priceMin ?? ''}
  data-resolution={targetResolution.join(',')}
>
  <!-- Imagem placeholder -->
  <div class="flex h-48 items-center justify-center bg-gray-100 dark:bg-gray-800">
    <svg class="h-20 w-20 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
    </svg>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <!-- Nome + Tags -->
    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">{shortName}</h3>
    <div class="mt-1.5 flex flex-wrap gap-1.5">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        {vram} GB
      </span>
      {targetResolution.map((res) => (
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
          {res}
        </span>
      ))}
    </div>

    <!-- Resumo -->
    <p class="mt-3 line-clamp-2 text-sm text-gray-500 dark:text-gray-400">
      {aiSummary}
    </p>

    <!-- FPS médio -->
    <div class="mt-3 flex items-center gap-2">
      <span class="text-xs text-gray-500 dark:text-gray-400">FPS médio 1440p:</span>
      <span class="font-semibold text-gray-900 dark:text-gray-100">{fpsAvg1440p}</span>
    </div>

    <!-- Preço + CTA -->
    <div class="mt-auto pt-4">
      {priceMin && priceMax ? (
        <p class="text-sm text-gray-500 dark:text-gray-400">
          A partir de <span class="font-bold text-gray-900 dark:text-gray-100">{formatBRL(priceMin)}</span>
        </p>
      ) : (
        <p class="text-sm text-gray-500 dark:text-gray-400">Preço indisponível</p>
      )}
      <a
        href={`/gpus/${slug}`}
        class="mt-2 flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition-colors"
        style={`background-color: var(--color-brand-red); hover:background-color: var(--color-brand-red-hover);`}
        class:list={[
          'hover:opacity-90',
          !inStock && 'opacity-50 pointer-events-none',
        ]}
      >
        {inStock ? 'Ver detalhes' : 'Indisponível'}
      </a>
    </div>
  </div>
</article>
