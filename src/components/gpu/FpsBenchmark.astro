---
import gpuData from '../../data/gpus.json';
import { formatFps } from '../../utils/format';

interface Props {
  fps: {
    '1080p': { avg: number };
    '1440p': { avg: number };
    '4K': { avg: number };
  };
  /** Observação específica da GPU (ex.: modelo testado com overclock de fábrica). */
  note?: string | null;
}

const { fps, note } = Astro.props;
const source = gpuData.sources.benchmarks;

const resolutions = ['1080p', '1440p', '4K'] as const;

function fpsColor(value: number): string {
  if (value >= 144) return 'text-green-500';
  if (value >= 60) return 'text-yellow-500';
  return 'text-red-500';
}

// Escala fixa para comparar visualmente entre páginas (a GPU mais rápida faz ~240 FPS em 1080p).
function fpsBarWidth(value: number): number {
  return Math.min((value / 250) * 100, 100);
}

const publishedBR = new Date(`${source.published}T12:00:00`).toLocaleDateString('pt-BR');
---

<div class="space-y-4">
  {resolutions.map((res) => (
    <div data-resolution={res}>
      <div class="mb-1 flex items-center justify-between">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{res}</span>
        <span class={`text-sm font-bold ${fpsColor(fps[res].avg)}`}>{formatFps(fps[res].avg)} FPS</span>
      </div>
      <div class="h-2 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
        <div
          class="h-full rounded-full bg-gradient-to-r from-red-500 via-yellow-500 to-green-500"
          style={`width: ${fpsBarWidth(fps[res].avg)}%`}
        />
      </div>
    </div>
  ))}

  <p class="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
    Média de FPS em 24 jogos, com {source.settings.charAt(0).toLowerCase() + source.settings.slice(1)}
    Máquina de teste: {source.testSystem}.
    {note && <>{note} </>}
    Fonte:{' '}
    <a href={source.url} target="_blank" rel="noopener" class="underline hover:text-gray-700 dark:hover:text-gray-200">TechPowerUp</a>
    {' '}(publicado em {publishedBR}).
  </p>
</div>
