---
import { getGameFpsByCategory, gameSource, RESOLUTIONS, type Resolution } from '../../utils/games';
import { formatFps } from '../../utils/format';

interface Props {
  gpuSlug: string;
  /** Resolução exibida ao abrir a página (normalmente a resolução ideal da GPU). */
  defaultResolution?: Resolution;
}

const { gpuSlug, defaultResolution = '1440p' } = Astro.props;
const groups = getGameFpsByCategory(gpuSlug);

function fpsColor(value: number): string {
  if (value >= 144) return 'text-green-600 dark:text-green-500';
  if (value >= 60) return 'text-yellow-600 dark:text-yellow-500';
  return 'text-red-600 dark:text-red-500';
}

const formatDate = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('pt-BR');
---

{groups.length > 0 && (
  <div class="game-fps" data-active-res={defaultResolution}>
    <div class="mb-4 flex gap-1 rounded-lg bg-gray-100 p-1 dark:bg-gray-800" role="group" aria-label="Resolução">
      {RESOLUTIONS.map((res) => (
        <button
          type="button"
          data-res-btn={res}
          aria-pressed={res === defaultResolution ? 'true' : 'false'}
          class="flex-1 rounded-md py-2 text-sm font-medium text-gray-500 transition-colors aria-pressed:bg-white aria-pressed:text-gray-900 aria-pressed:shadow-sm dark:text-gray-400 dark:aria-pressed:bg-gray-700 dark:aria-pressed:text-gray-100"
        >
          {res}
        </button>
      ))}
    </div>

    <div class="space-y-5">
      {groups.map(({ category, games }) => (
        <section data-category={category.slug}>
          <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
            {category.name}{' '}<span class="font-normal">({games.length})</span>
          </h3>
          <ul class="divide-y divide-gray-100 overflow-hidden rounded-xl border border-gray-200 dark:divide-gray-800 dark:border-gray-800">
            {games.map((game) => (
              <li class="flex items-center justify-between px-4 py-2.5" data-game={game.slug}>
                <span class="text-sm text-gray-700 dark:text-gray-300">{game.name}</span>
                {RESOLUTIONS.map((res) => (
                  <span data-res={res} class={`text-sm font-bold tabular-nums ${fpsColor(game.fps[res])}`}>
                    {formatFps(game.fps[res])} FPS
                  </span>
                ))}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="mt-3 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
      FPS médio em cada jogo, com qualidade máxima, resolução nativa, sem ray tracing e sem DLSS/FSR.
      Fonte: TechPowerUp, reviews{' '}
      {gameSource.reviews.map((review, i) => (
        <>
          {i > 0 && ' e '}
          <a href={review.url} target="_blank" rel="noopener" class="underline hover:text-gray-700 dark:hover:text-gray-200">{review.title}</a>
          {' '}({formatDate(review.published)})
        </>
      ))}, feitos na mesma máquina de teste.
    </p>
  </div>
)}

<style>
  .game-fps[data-active-res='1080p'] [data-res]:not([data-res='1080p']),
  .game-fps[data-active-res='1440p'] [data-res]:not([data-res='1440p']),
  .game-fps[data-active-res='4K'] [data-res]:not([data-res='4K']) {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.game-fps').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-res-btn]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        root.dataset.activeRes = btn.dataset.resBtn;
        buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      });
    });
  });
</script>
