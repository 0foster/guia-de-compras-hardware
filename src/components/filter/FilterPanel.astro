---

---

<div class="space-y-6">
  <!-- Resolução Alvo -->
  <div>
    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Resolução</h3>
    <div class="space-y-2">
      {['1080p', '1440p', '4K'].map((res) => (
        <label class="flex cursor-pointer items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <input type="checkbox" value={res} data-filter="resolution" class="h-4 w-4 rounded border-gray-300 accent-[var(--color-brand-red)] dark:border-gray-600" />
          {res}
        </label>
      ))}
    </div>
  </div>

  <!-- Preço -->
  <div>
    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Preço</h3>

    <div class="price-slider relative mt-2 mb-1 h-6 px-2">
      <div class="absolute top-1/2 left-2 right-2 h-1 -translate-y-1/2 rounded-full bg-gray-200 dark:bg-gray-700"></div>
      <div id="price-range-fill" class="absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-[var(--color-brand-red)]" style="left: 0%; right: 0%;"></div>
      <input
        type="range"
        id="price-min-handle"
        min="0"
        max="200000"
        step="100"
        value="0"
        class="price-handle"
        aria-label="Preço mínimo (slider)"
      />
      <input
        type="range"
        id="price-max-handle"
        min="0"
        max="200000"
        step="100"
        value="200000"
        class="price-handle"
        aria-label="Preço máximo (slider)"
      />
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3">
      <div>
        <label for="price-min-input" class="block text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Vlr. Mínimo</label>
        <input
          type="text"
          id="price-min-input"
          inputmode="decimal"
          placeholder="R$ 0,00"
          autocomplete="off"
          class="mt-1 w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 focus:border-[var(--color-brand-red)] focus:outline-none focus:ring-1 focus:ring-[var(--color-brand-red)] dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        />
      </div>
      <div>
        <label for="price-max-input" class="block text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Vlr. Máximo</label>
        <input
          type="text"
          id="price-max-input"
          inputmode="decimal"
          placeholder="R$ 200.000,00"
          autocomplete="off"
          class="mt-1 w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 focus:border-[var(--color-brand-red)] focus:outline-none focus:ring-1 focus:ring-[var(--color-brand-red)] dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        />
      </div>
    </div>
  </div>

  <!-- VRAM Mínima -->
  <div>
    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">VRAM Mínima</h3>
    <div class="space-y-2">
      {[
        { label: 'Sem preferência', value: '0' },
        { label: '8 GB', value: '8' },
        { label: '12 GB+', value: '12' },
        { label: '16 GB+', value: '16' },
      ].map((opt) => (
        <label class="flex cursor-pointer items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <input type="radio" name="vram" value={opt.value} data-filter="vram" class="h-4 w-4 border-gray-300 accent-[var(--color-brand-red)] dark:border-gray-600" checked={opt.value === '0'} />
          {opt.label}
        </label>
      ))}
    </div>
  </div>

  <!-- Botão limpar filtros -->
  <button
    id="clear-filters"
    class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800"
  >
    Limpar filtros
  </button>
</div>

<style>
  .price-handle {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    width: 100%;
    height: 24px;
    transform: translateY(-50%);
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    margin: 0;
    padding: 0;
    z-index: 2;
  }

  .price-handle::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    height: 18px;
    width: 18px;
    border-radius: 50%;
    background: var(--color-brand-red);
    cursor: pointer;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .price-handle::-moz-range-thumb {
    pointer-events: auto;
    height: 18px;
    width: 18px;
    border-radius: 50%;
    background: var(--color-brand-red);
    cursor: pointer;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .price-handle::-webkit-slider-runnable-track {
    background: transparent;
    border: none;
  }

  .price-handle::-moz-range-track {
    background: transparent;
    border: none;
  }

  :global(.dark) .price-handle::-webkit-slider-thumb {
    border-color: rgb(15 23 42);
  }

  :global(.dark) .price-handle::-moz-range-thumb {
    border-color: rgb(15 23 42);
  }
</style>
